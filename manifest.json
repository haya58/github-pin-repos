{
  "manifest_version": 3,
  "name": "Github Pin Repos",
  "version": "1.0",
  "description": "GitHubトップページでリポジトリをピン留めできるようにする拡張機能",
  "permissions": ["storage"],
  "host_permissions": ["*://*/*"],
  "content_scripts": [
    {
      "matches": ["*://*/*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "options_page": "options.html",
  "icons": {
   "16": "logo.png",
   "32": "logo.png",
   "48": "logo.png",
   "128": "logo.png"
 }
}
